---
pagination:
    data: recipes
    size: 1
    alias: recipeId
eleventyComputed:
    permalink: "|!{recipeId}/index.html"
---
extends /layout.pug

mixin lbl(id, text, details=false)
    section(class=id)
        if !details
            label(for=id)
                h3=text
            if block
                block
        else
            details
                summary
                    h3=text
                if block
                    block

block content

    link(rel="stylesheet" href="/static/recipe.css")
    - const recipe = recipes[recipeId]
    main
        h1 Yazi

        fieldset
            legend
                h2 Settings

            +lbl("layout", "Keyboard layout")
                select#layout
                    for layout in azertyAll
                        - const lbl = layout.name ? `${layout.name} (${layout.id})` : layout.id;
                        - const selected = layout.id == "be";
                        option(value=layout.id selected=selected)=lbl

            +lbl("recipe", "Recipe ", true)
                a(href="https://github.com/Denperidge/xkb-azerty/tree/main/webtool/src/_data") (see schema.json & the recipes/ dir in the source code)
                textarea#recipe=JSON.stringify(recipe, undefined, 2)

        button(id="parse" value="Parse") Parse

        fieldset
            legend
                h2 Input/Output

            +lbl("input", "Original")
                textarea#input

            +lbl("output", "Parsed")
                textarea#output


