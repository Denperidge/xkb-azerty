{
    "$schema": "../schema.json",
    "name": "Yazi numeric (tag: shipped)",
    "url": "https://raw.githubusercontent.com/sxyazi/yazi/refs/tags/shipped/yazi-config/preset/keymap-default.toml",
    "mode": "unicode",
    "outputTemplate": "\"${KEY}\"",
    "replace": {
        "\"1\"": "AE01",
        "\"2\"": "AE02",
        "\"3\"": "AE03",
        "\"4\"": "AE04",
        "\"5\"": "AE05",
        "\"6\"": "AE06",
        "\"7\"": "AE07",
        "\"8\"": "AE08",
        "\"9\"": "AE09",
        "\"0\"": "AE10"
    }
}
