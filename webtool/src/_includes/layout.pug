doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        - const title = "title";
        - const description = "description";
        title=title
        meta(name="description", content=description)
        meta(property="og:title" content=title)
        meta(property="og:description" content=description)
        
        meta(property="og:url" content="base_url" + page.url)
        meta(property="og:site_name" content=title)

        //-link(rel="stylesheet" href="/static/mvp.css")
        
        block head
    body 
        header
            nav(aria-labelledby="recipes")
                h2#recipes Recipes
                ul
                    for recipe, recipeId in recipes
                        a(href=`/${recipeId}`)
                            li=recipe.name

            if page.url == "/"
                nav(aria-labelledby="datafiles").datafiles
                    h2#datafiles Data files
                    ul
                        for filename in datafiles
                            a(href=`/data/${filename}`)
                                li=filename.replace(/.min.json/, "")


        block content
            main
                | !{content}

        script(src="/static/index.js")


