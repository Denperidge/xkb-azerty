{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "name",
        "url",
        "mode",
        "replace"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "url": {
            "type":"string"
        },
        "mode": {
            "type": "string",
            "enum": [
                "xkb",
                "unicode"
            ]
        },
        "replace": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "string",
                    "pattern": "\\w{4}"
                }   
            },
            "properties": {

                
            }
        }
    }
}
