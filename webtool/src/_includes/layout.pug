doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title=title + " | xkb-azerty"
        meta(name="description", content=description)
        meta(property="og:title" content=title)
        meta(property="og:description" content=description)
        
        meta(property="og:url" content=base_url + page.url)
        meta(property="og:site_name" content="xkb-azerty")

        link(rel="stylesheet" href="/static/wing.min.css")
        link(rel="stylesheet" href="/static/stylesheet.css")
        
        block head
    body 
        header
            nav
                ul
                    a(href="/")
                        li Home
                    a(href="/data")
                        li Data files
                    for recipe, recipeId in recipes
                        a(href=`/${recipeId}`)
                            li=recipe.name

        block content
            main
                | !{content}

        footer
            <a href="https://github.com/denperidge/xkb-azerty">Source code</a>

        script(src="/static/index.js")


